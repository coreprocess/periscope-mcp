# Local configuration for `node src/index.ts --env-file .env.periscope` (stdio mode).
# Copy to .env.periscope (gitignored) and adjust. Full reference: docs/configuration.md

PERISCOPE_SOURCE_N=2

PERISCOPE_SOURCE_0_NAME=shop
PERISCOPE_SOURCE_0_TYPE=postgres
PERISCOPE_SOURCE_0_URL=postgres://reader:secret@localhost:5432/shop
PERISCOPE_SOURCE_0_DESCRIPTION=Shop orders and customers (local copy)

PERISCOPE_SOURCE_1_NAME=docs
PERISCOPE_SOURCE_1_TYPE=cosmos
PERISCOPE_SOURCE_1_CONNECTION_STRING=AccountEndpoint=https://example.documents.azure.com:443/;AccountKey=<read-only key>;
PERISCOPE_SOURCE_1_DATABASE=main
