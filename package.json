{
    "name": "periscope-mcp",
    "version": "0.1.0",
    "description": "Read-only MCP server for Postgres, Oracle, Cosmos DB, Blob Storage, Log Analytics and Redis",
    "license": "MIT",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@10.33.0",
    "bin": {
        "periscope-mcp": "dist/index.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "biome check .",
        "format": "biome check --write .",
        "start": "node dist/index.js",
        "dev": "node src/index.ts",
        "test": "node --test --test-reporter=spec \"test/unit/**/*.test.ts\"",
        "test:integration": "node --test --test-reporter=spec --test-concurrency=1 \"test/integration/**/*.test.ts\"",
        "test:all": "pnpm test && pnpm test:integration"
    },
    "dependencies": {
        "@azure/core-rest-pipeline": "1.25.0",
        "@azure/cosmos": "4.10.1",
        "@azure/identity": "4.14.0",
        "@azure/storage-blob": "12.34.0",
        "@modelcontextprotocol/express": "2.0.2",
        "@modelcontextprotocol/node": "2.1.1",
        "@modelcontextprotocol/server": "2.3.1",
        "@redis/client": "6.3.0",
        "@redis/entraid": "6.3.0",
        "express": "5.3.0",
        "hyparquet": "1.31.5",
        "hyparquet-writer": "0.17.0",
        "jose": "6.2.13",
        "libpg-query": "18.1.5",
        "oracledb": "26.0.0",
        "pg": "8.23.1",
        "pg-cursor": "2.22.1",
        "pino": "10.4.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.2",
        "@modelcontextprotocol/client": "2.3.1",
        "@types/express": "5.0.6",
        "@types/node": "^24.19.2",
        "@types/oracledb": "7.0.3",
        "@types/pg": "8.23.1",
        "@types/pg-cursor": "2.7.2",
        "testcontainers": "12.2.1",
        "typescript": "7.0.2"
    },
    "pnpm": {
        "ignoredBuiltDependencies": [
            "cpu-features",
            "oracledb",
            "protobufjs",
            "ssh2"
        ]
    }
}
